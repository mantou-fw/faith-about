---
import { SEO } from 'astro-seo';
import { withBase } from '@/utils/base';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'Faith LI';
const site = Astro.site ?? new URL('https://mantou-fw.github.io');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Astro.url.pathname already carries `base` on a static build, so the canonical
// is the pathname against the site origin — no manual prefixing needed.
const canonicalUrl = canonical
  ? new URL(canonical, site).href
  : new URL(Astro.url.pathname, site).href;
const imageUrl = image ? new URL(base + image, site).href : undefined;
const pageTitle = title.includes(siteName) ? title : title + ' | ' + siteName;
const sitemapUrl = new URL(base + '/sitemap.xml', site).href;
const structuredData =
  jsonLd ??
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: site.href,
  };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon/favicon.svg')} />
    <link rel="icon" sizes="48x48" href={withBase('/favicon/favicon.ico')} />
    <link rel="apple-touch-icon" href={withBase('/favicon/apple-touch-icon.png')} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />

    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      robotsExtras="max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <meta
      name="twitter:card"
      content={imageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    ></script>

    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
