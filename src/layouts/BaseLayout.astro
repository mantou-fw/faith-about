---
import { withBase } from '@/lib/paths';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/site/echo/Header.astro';
import Footer from '@/components/site/echo/Footer.astro';
import { TooltipProvider } from '@/components/ui/echo/index.js';
import '../styles/echo-fonts.css';
import '../styles/portfolio.css';

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image = "/images/portfolio/avatar.png",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'Mantou / Faith';
const site = Astro.site ?? new URL('https://example.com');
const canonicalUrl = canonical
  ? new URL(canonical, site).href
  : new URL(Astro.url.pathname, site).href;
const imageUrl = image ? new URL(withBase(image), site).href : undefined;
const pageTitle = title;
const structuredData =
  jsonLd ??
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: new URL(import.meta.env.BASE_URL, site).href,
  };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      robotsExtras="max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <meta
      name="twitter:card"
      content={imageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <link rel="sitemap" type="application/xml" href={withBase("/sitemap.xml")} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    ></script>

    <link rel="stylesheet" href={withBase("/echo.css")} />
    <link rel="icon" type="image/png" href={withBase("/images/portfolio/avatar.png")} />
    <link rel="apple-touch-icon" href={withBase("/images/portfolio/avatar.png")} />
    <ClientRouter />
    <script is:inline data-astro-rerun>
      (() => {
        try {
          document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
        } catch {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <TooltipProvider delayDuration={300} client:load>
      <Header />
      <slot />
      <Footer />
    </TooltipProvider>
  </body>
</html>
