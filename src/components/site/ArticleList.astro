---
import { cn } from '@/utils/cn';
import Container from '@/components/site/Container.astro';
import type { Article } from '@/data/about';

/**
 * Divided list of recent writing, newest first.
 *
 * The article routes do not exist yet — this site is one page. Each row stays a
 * real `<a>` so it is focusable and announced correctly, pointing at its future
 * URL, but carries `aria-disabled` and a muted treatment so it is not mistaken
 * for something that works today. Adding the pages later needs no change here.
 */
export interface Props {
  title?: string;
  allHref?: string;
  allLabel?: string;
  articles: Article[];
  class?: string;
}

const {
  title = 'Latest writing',
  allHref = '/articles',
  allLabel = 'Read all',
  articles,
  class: className,
} = Astro.props;
---

<div class={cn('space-y-10', className)}>
  <Container class="flex items-center justify-between">
    <h2 class="text-2xl leading-none">{title}</h2>
    <a href={allHref} aria-disabled="true" class="link-underline text-lg leading-none opacity-60">
      {allLabel}
    </a>
  </Container>

  <ul class="divide-y rounded-3xl border shadow-xs">
    {
      articles.map((article) => (
        <li class="relative first:rounded-t-3xl last:rounded-b-3xl">
          <a
            href={article.href}
            aria-disabled="true"
            class="hover:bg-muted/40 relative z-10 flex items-start justify-between gap-6 p-10 transition-colors"
          >
            <div class="space-y-5">
              <div class="flex items-center gap-3">
                <h3 class="text-lg leading-none">{article.title}</h3>
              </div>
              <p class="text-muted-foreground text-base leading-7">{article.excerpt}</p>
              <span class="text-base leading-6">{article.date}</span>
            </div>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="text-muted-foreground size-5 shrink-0"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</div>