---
import { Card } from '@/components/ui';
import Container from '@/components/site/Container.astro';
import Section from '@/components/site/Section.astro';
import { withAsset } from '@/utils/base';
import { profile, story } from '@/data/about';
---

<Section variant="hero" class="pb-12.5 md:pb-15 lg:pb-18.75">
  <Container>
    <h1 class="text-3xl md:text-4xl">{profile.about}</h1>
  </Container>

  <Container size="wide" class="hero-padding">
    <Card class="relative aspect-video overflow-hidden rounded-3xl border p-0 shadow-xs">
      <img
        src={withAsset('/images/home/avatar.webp')}
        alt={`${profile.name} working`}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
        class="size-full object-cover"
      />
    </Card>
  </Container>

  <Container class="space-y-10">
    <h2 class="text-2xl">Story</h2>
    <div class="text-muted-foreground space-y-8 text-lg">
      {story.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </Container>
</Section>