---
import { profile } from '@/data/portfolio.json';
const { about = false } = Astro.props;
---
<section class="hero-padding container space-y-10">
  <img src={profile.avatar} alt={profile.name + ' avatar'} width="64" height="64" class="size-16 rounded-full object-cover" />
  <div class="flex flex-col gap-5">
    <h1 class="text-3xl md:text-4xl">{about ? `About ${profile.name}` : `Hi, I'm ${profile.name}`}</h1>
    <p class="text-muted-foreground text-lg leading-7">{profile.intro}</p>
    {about && <p class="text-lg leading-7">{profile.role} · {profile.location}</p>}
    {about && <p class="text-muted-foreground text-lg leading-7">{profile.about}</p>}
  </div>
  <div class="flex flex-wrap gap-5"><a href={profile.github} class="link-underline text-lg">github.com/{profile.handle} ↗</a>
  {about && <a href={profile.businessUrl} class="link-underline text-lg">HTIFA ↗</a>}</div>
</section>
