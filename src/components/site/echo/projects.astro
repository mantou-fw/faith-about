---
import ProjectsTabs from '../../echo/projects-tabs.js';
import { projects } from '@/data/portfolio.json';
---
<main class="flex-1">
  <section class="hero-padding">
    <div class="container flex flex-col gap-5">
      <h1 class="text-3xl md:text-4xl">Projects & experiments</h1>
      <p class="text-muted-foreground text-lg leading-7">Public projects — starters, developer tools, AWS study resources and HTIFA.</p>
    </div>
    <ProjectsTabs projects={projects} client:load />
  </section>
</main>
