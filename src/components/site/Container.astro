---
/**
 * Layout primitives that reproduce the template's container rhythm.
 *
 * The template ships three width steps, each a custom class rather than a
 * Tailwind max-width utility:
 *
 *   .container         880px, 20px inline padding from md — standard column
 *   .bigger-container  952px, 16px padding at every width — wider media
 *   (none)             fluid  — full-bleed
 *
 * The padding difference is deliberate in the template, not an oversight:
 * `bigger-container` never steps up.
 */

export interface Props {
  as?: string;
  size?: 'default' | 'wide' | 'fluid';
  class?: string;
}

const { as: Tag = 'div', size = 'default', class: className } = Astro.props;

const sizes = {
  default: 'mx-auto w-full max-w-[880px] px-4 md:px-5',
  wide: 'mx-auto w-full max-w-[952px] px-4',
  fluid: 'mx-auto w-full px-4 md:px-5',
} as const;
---

<Tag class:list={[sizes[size], className]}><slot /></Tag>