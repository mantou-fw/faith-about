---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectDetail from '@/components/site/echo/ProjectDetail.astro';
import { projects } from '@/data/portfolio.json';
export const prerender = true;
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.name + ' · Mantou / Faith'} description={project.description} image={project.image}><ProjectDetail project={project} /></BaseLayout>
