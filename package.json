    "design:update": "impeccable update",
    "design:check": "impeccable check",
    "design:detect": "impeccable detect src/",
    "test": "bun test",
    "start": "bun ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "astro-seo": "^1.2.0",
    "clsx": "^2.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sitemap": "^9.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "@astrojs/node": "^11.1.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "bearnie": "^0.3.2",
