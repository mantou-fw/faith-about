  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "check": "bun --bun astro check --minimumSeverity warning",
    "ui:list": "bearnie list",
    "ui:add": "bearnie add",
    "ui:diff": "bearnie diff",
