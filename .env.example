# Build-time canonical origin. No trailing slash.
SITE_URL=https://mantou-fw.github.io

# Public site label used in page titles and structured data.
PUBLIC_SITE_NAME=Faith LI

# Deployment subpath. Empty when hosting at a domain root.
SITE_BASE=/faith-about

# Footer contact link.
PUBLIC_CONTACT_EMAIL=mantou.fw@gmail.com

# Optional. Leave blank to disable Google Tag / GA4.
# Examples: G-XXXXXXXXXX or GT-XXXXXXXXXX
PUBLIC_GOOGLE_TAG_ID=